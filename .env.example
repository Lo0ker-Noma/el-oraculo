# Todo es OPCIONAL: sin nada de esto, El Oraculo arranca en MODO DEMO
# (pagos simulados + veredicto simulado) para poder probar el flujo completo.

# Wallet del oraculo (NWC de Alby / LNbits / LaWallet). Con esto los pagos son REALES:
# cobra las apuestas a su bote y reparte premios a las Lightning addresses ganadoras.
# NWC_URL=nostr+walletconnect://...

# --- IA del oraculo (orden: Gemini -> Grok -> Claude -> demo) ---
# Google Gemini (AI Studio). GRATIS y sin tarjeta: https://aistudio.google.com
# OJO free tier: 20 peticiones/dia por modelo. El oraculo gasta 1-2 por resolucion.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.5-flash
#
# Busqueda web general para el oraculo (opcional, free tier): https://tavily.com
# TAVILY_API_KEY=tvly-...
#
# Grok (xAI) con Live Search nativo. RECOMENDADO. Key en https://console.x.ai
# XAI_API_KEY=xai-...
# GROK_MODEL=grok-4.5
#
# Alternativa: Claude (Anthropic) con web search. https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Identidad Nostr del oraculo para publicar sus veredictos (nsec1... o hex).
# ORACLE_NSEC=nsec1...

# Secreto para firmar los tokens de sesion del login Nostr. Si no se define,
# se genera uno aleatorio al arrancar (las sesiones se invalidan en cada reinicio).
# SESSION_SECRET=cadena-larga-y-aleatoria

# PORT=5220
